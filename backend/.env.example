APP_NAME="René Mejillón Dev"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-backend.onrender.com

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Render PostgreSQL ---
# Render genera estas variables automáticamente al vincular la DB.
# En el dashboard: Environment > Add from Database
DB_CONNECTION=pgsql
DB_HOST=your-db.oregon-postgres.render.com
DB_PORT=5432
DB_DATABASE=rene_mejillon_dev
DB_USERNAME=rene_mejillon_dev_user
DB_PASSWORD=your-render-db-password
DB_SSLMODE=require

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

SANCTUM_STATEFUL_DOMAINS=localhost:3000,your-frontend.vercel.app

CORS_ALLOWED_ORIGINS=http://localhost:3000,https://your-frontend.vercel.app

ADMIN_EMAIL=admin@renemejillon.dev
ADMIN_PASSWORD=changeme_before_deploy
